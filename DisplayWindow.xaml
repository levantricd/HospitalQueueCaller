<Window x:Class="HospitalQueueCaller.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        ShowInTaskbar="False">

    <Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- Dòng thông báo -->
            <TextBlock Text="XIN MỜI SỐ THỨ TỰ TỪ"
                       Foreground="White"
                       FontSize="55"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Số bắt đầu -->
            <TextBlock x:Name="txtDisplayStart"
                       Text="001"
                       Foreground="White"
                       FontSize="180"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Chữ ĐẾN -->
            <TextBlock Text="ĐẾN"
                       Foreground="White"
                       FontSize="50"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,10"/>

            <!-- Số kết thúc -->
            <TextBlock x:Name="txtDisplayEnd"
                       Text="010"
                       Foreground="White"
                       FontSize="180"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>

</Window>