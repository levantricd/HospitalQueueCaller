<Window x:Class="HospitalQueueCaller.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Normal"
        ResizeMode="NoResize"
        Background="#FFFDF7"
        ShowInTaskbar="False"
        Topmost="True">

    <Viewbox Stretch="Uniform"
             StretchDirection="Both">

        <Grid Width="1920"
              Height="1080">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,30,0,0">

                <TextBlock Text="XIN MỜI SỐ THỨ TỰ"
                           Foreground="#111111"
                           FontSize="68"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <!-- Chỉ hiển thị khi là SỐ ƯU TIÊN -->
                <TextBlock x:Name="txtDisplayMode"
                           Text=""
                           Foreground="#8B0000"
                           FontSize="80"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- KHU VỰC HIỂN THỊ SỐ -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ============================================= -->
                <!-- SỐ BẮT ĐẦU -->
                <!-- ============================================= -->

                <TextBlock Grid.Column="0"
                           x:Name="txtDisplayStart"
                           Text="001"
                           Foreground="#000000"
                           FontSize="400"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>


                <!-- ============================================= -->
                <!-- DẤU NGĂN CÁCH -->
                <!-- ============================================= -->

                <TextBlock Grid.Column="1"
                           Text=" – "
                           Foreground="#333333"
                           FontSize="150"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="5,0"/>


                <!-- ============================================= -->
                <!-- SỐ KẾT THÚC -->
                <!-- ============================================= -->

                <TextBlock Grid.Column="2"
                           x:Name="txtDisplayEnd"
                           Text="010"
                           Foreground="#000000"
                           FontSize="400"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Grid>

        </Grid>

    </Viewbox>

</Window>