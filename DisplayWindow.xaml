<Window x:Class="HospitalQueueCaller.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#FFFDF7"
        ShowInTaskbar="False">

    <Grid>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- TIÊU ĐỀ -->
            <TextBlock Text="XIN MỜI SỐ THỨ TỰ"
                       Foreground="#111111"
                       FontSize="60"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>


            <!-- LOẠI SỐ -->
            <TextBlock x:Name="txtDisplayMode"
                       Text="SỐ THƯỜNG"
                       Foreground="#174A7E"
                       FontSize="50"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>


            <!-- SỐ BẮT ĐẦU -->
            <TextBlock x:Name="txtDisplayStart"
                       Text="001"
                       Foreground="#000000"
                       FontSize="200"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>


            <!-- ĐẾN -->
            <TextBlock Text="ĐẾN"
                       Foreground="#444444"
                       FontSize="55"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,5"/>


            <!-- SỐ KẾT THÚC -->
            <TextBlock x:Name="txtDisplayEnd"
                       Text="010"
                       Foreground="#000000"
                       FontSize="200"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>

</Window>