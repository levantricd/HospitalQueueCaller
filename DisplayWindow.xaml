<Window x:Class="HospitalQueueCaller.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Maximized"
        Background="#FFFDF7"
        ShowInTaskbar="False">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <TextBlock Text="XIN MỜI SỐ THỨ TỰ"
                       Foreground="#111111"
                       FontSize="72"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="txtDisplayMode"
                       Text="SỐ THƯỜNG"
                       Foreground="#174A7E"
                       FontSize="64"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

        </StackPanel>


        <!-- KHU VỰC SỐ -->
        <Grid Grid.Row="1"
              VerticalAlignment="Stretch"
              Margin="0,0,0,10">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- SỐ BẮT ĐẦU -->
            <TextBlock Grid.Row="0"
                       x:Name="txtDisplayStart"
                       Text="001"
                       Foreground="#000000"
                       FontSize="300"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>


            <!-- ĐẾN -->
            <TextBlock Grid.Row="1"
                       Text="ĐẾN"
                       Foreground="#444444"
                       FontSize="65"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,-15,0,-15"/>


            <!-- SỐ KẾT THÚC -->
            <TextBlock Grid.Row="2"
                       x:Name="txtDisplayEnd"
                       Text="010"
                       Foreground="#000000"
                       FontSize="300"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>