<Window x:Class="HospitalQueueCaller.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        WindowState="Normal"
        ResizeMode="NoResize"
        Background="#FFFDF7"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- TIÊU ĐỀ -->

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <TextBlock Text="XIN MỜI SỐ THỨ TỰ"
                       Foreground="#111111"
                       FontSize="68"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="txtDisplayMode"
                       Text="SỐ THƯỜNG"
                       Foreground="#174A7E"
                       FontSize="58"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- SỐ -->

        <Grid Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <TextBlock Grid.Column="0"
                       x:Name="txtDisplayStart"
                       Text="001"
                       Foreground="#000000"
                       FontSize="300"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>


            <TextBlock Grid.Column="1"
                       Text="  –  "
                       Foreground="#333333"
                       FontSize="190"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="20,0"/>


            <TextBlock Grid.Column="2"
                       x:Name="txtDisplayEnd"
                       Text="010"
                       Foreground="#000000"
                       FontSize="300"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</Window>