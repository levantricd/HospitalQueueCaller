<Window x:Class="HospitalQueueCaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hospital Queue Caller"
        Height="700"
        Width="1100">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="27*"/>
            <ColumnDefinition Width="238*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0"
                   Text="HỆ THỐNG GỌI SỐ THỨ TỰ"
                   FontSize="32"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="216,0,0,20" Grid.Column="1"/>

        <!-- Khu vực chính -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cấu hình -->
            <GroupBox Grid.Column="0"
                      Header="CẤU HÌNH DÃY SỐ"
                      Margin="10">

                <StackPanel Margin="20">

                    <TextBlock Text="Số bắt đầu"/>
                    <TextBox x:Name="txtStartNumber"
                             Text="001"
                             FontSize="22"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Số kết thúc"/>
                    <TextBox x:Name="txtEndNumber"
                             Text="010"
                             FontSize="22"
                             Margin="0,5,0,15"/>

                    <TextBlock Text="Bước tăng"/>
                    <TextBox x:Name="txtStep"
                             Text="1"
                             FontSize="22"
                             Margin="0,5,0,15"/>

                    <Button x:Name="btnStart"
                            Content="BẮT ĐẦU DÃY"
                            Height="50"
                            FontSize="20"
                            Margin="0,10,0,0"/>

                    <Button x:Name="btnReset"
                            Content="RESET"
                            Height="50"
                            FontSize="20"
                            Margin="0,10,0,0"/>

                </StackPanel>

            </GroupBox>

            <!-- Hiển thị số -->
            <GroupBox Grid.Column="1"
                      Header="SỐ HIỆN TẠI"
                      Margin="10">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock x:Name="txtCurrentNumber"
                               Text="000"
                               FontSize="100"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <Button x:Name="btnNext"
                            Content="GỌI TIẾP THEO"
                            Width="300"
                            Height="70"
                            FontSize="25"
                            Margin="0,30,0,0"/>

                </StackPanel>

            </GroupBox>

        </Grid>

        <!-- Trạng thái -->
        <Border Grid.Row="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Padding="15"
                Margin="10,10,10,10" Grid.ColumnSpan="2">

            <TextBlock x:Name="txtStatus"
                       Text="Trạng thái: Chưa khởi động"
                       FontSize="20"/>

        </Border>

    </Grid>

</Window>