<Window x:Class="HospitalQueueCaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý gọi số"
        Height="600"
        Width="850"
        MinHeight="520"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0"
                   Text="QUẢN LÝ GỌI SỐ"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#222222"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>


        <!-- HAI BỘ SỐ -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ========================= -->
            <!-- SỐ THƯỜNG -->
            <!-- ========================= -->

            <GroupBox Grid.Column="0"
                      Header="SỐ THƯỜNG"
                      FontSize="19"
                      FontWeight="Bold"
                      Margin="5"
                      Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- SỐ BẮT ĐẦU -->
                    <TextBlock Grid.Row="0"
                               Text="Số bắt đầu"
                               FontSize="16"/>

                    <TextBox Grid.Row="1"
                             x:Name="txtNormalStart"
                             Text="1"
                             FontSize="21"
                             Height="40"
                             Margin="0,4,0,10"/>


                    <!-- BƯỚC TĂNG -->
                    <TextBlock Grid.Row="2"
                               Text="Bước tăng"
                               FontSize="16"/>

                    <TextBox Grid.Row="3"
                             x:Name="txtNormalStep"
                             Text="10"
                             FontSize="21"
                             Height="40"
                             VerticalAlignment="Top"
                             Margin="0,4,0,10"/>


                    <!-- NÚT + DÃY -->
                    <StackPanel Grid.Row="4">

                        <TextBlock Text="Dãy đang gọi"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtNormalRange"
                                   Text="---"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#174A7E"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,8"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnStartNormal"
                                    Content="BẮT ĐẦU"
                                    Width="145"
                                    Height="48"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Margin="3"/>

                            <Button x:Name="btnNextNormal"
                                    Content="GỌI TIẾP"
                                    Width="145"
                                    Height="48"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Margin="3"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </GroupBox>


            <!-- ========================= -->
            <!-- SỐ ƯU TIÊN -->
            <!-- ========================= -->

            <GroupBox Grid.Column="1"
                      Header="SỐ ƯU TIÊN"
                      FontSize="19"
                      FontWeight="Bold"
                      Margin="5"
                      Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- SỐ BẮT ĐẦU -->
                    <TextBlock Grid.Row="0"
                               Text="Số bắt đầu"
                               FontSize="16"/>

                    <TextBox Grid.Row="1"
                             x:Name="txtPriorityStart"
                             Text="1"
                             FontSize="21"
                             Height="40"
                             Margin="0,4,0,10"/>


                    <!-- BƯỚC TĂNG -->
                    <TextBlock Grid.Row="2"
                               Text="Bước tăng"
                               FontSize="16"/>

                    <TextBox Grid.Row="3"
                             x:Name="txtPriorityStep"
                             Text="5"
                             FontSize="21"
                             Height="40"
                             VerticalAlignment="Top"
                             Margin="0,4,0,10"/>


                    <!-- NÚT + DÃY -->
                    <StackPanel Grid.Row="4">

                        <TextBlock Text="Dãy đang gọi"
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtPriorityRange"
                                   Text="---"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="#8B0000"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,8"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnStartPriority"
                                    Content="BẮT ĐẦU"
                                    Width="145"
                                    Height="48"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Margin="3"/>

                            <Button x:Name="btnNextPriority"
                                    Content="GỌI TIẾP"
                                    Width="145"
                                    Height="48"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Margin="3"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </GroupBox>

        </Grid>


        <!-- ========================= -->
        <!-- TRẠNG THÁI -->
        <!-- ========================= -->

        <Border Grid.Row="2"
                BorderBrush="#BBBBBB"
                BorderThickness="1"
                Background="White"
                Padding="10"
                Margin="5,10,5,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="ĐANG GỌI:"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="txtActiveMode"
                           Text="CHƯA GỌI SỐ"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="#174A7E"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           x:Name="txtStatus"
                           Text="Sẵn sàng"
                           FontSize="14"
                           Foreground="#555555"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>