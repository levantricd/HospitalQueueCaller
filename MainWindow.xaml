<Window x:Class="HospitalQueueCaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý gọi số"
        Height="700"
        Width="780"
        MinHeight="600"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="315"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- TIÊU ĐỀ + CHUYỂN MÀN HÌNH -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,8">

            <TextBlock Text="QUẢN LÝ GỌI SỐ"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#222222"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <Button x:Name="btnSwitchScreen"
                    Content="CHUYỂN MÀN HÌNH"
                    Width="145"
                    Height="34"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>

        </Grid>


        <!-- ================================================= -->
        <!-- HAI BỘ SỐ -->
        <!-- ================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- SỐ THƯỜNG -->
            <!-- ================================================= -->

            <GroupBox Grid.Column="0"
                      Header="SỐ THƯỜNG"
                      FontSize="17"
                      FontWeight="Bold"
                      Margin="3"
                      Padding="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Text="Số bắt đầu"
                               FontSize="14"/>

                    <TextBox Grid.Row="1"
                             x:Name="txtNormalStart"
                             Text="1"
                             FontSize="19"
                             Height="34"
                             Margin="0,2,0,5"/>


                    <TextBlock Grid.Row="2"
                               Text="Bước tăng"
                               FontSize="14"/>

                    <TextBox Grid.Row="3"
                             x:Name="txtNormalStep"
                             Text="10"
                             FontSize="19"
                             Height="34"
                             Margin="0,2,0,5"/>


                    <TextBlock Grid.Row="4"
                               Text="Dãy đang gọi"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"/>


                    <StackPanel Grid.Row="5">

                        <TextBlock x:Name="txtNormalRange"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#174A7E"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnStartNormal"
                                    Content="BẮT ĐẦU"
                                    Width="120"
                                    Height="40"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Margin="2"/>

                            <Button x:Name="btnNextNormal"
                                    Content="GỌI TIẾP"
                                    Width="120"
                                    Height="40"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Margin="2"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </GroupBox>


            <!-- ================================================= -->
            <!-- SỐ ƯU TIÊN -->
            <!-- ================================================= -->

            <GroupBox Grid.Column="1"
                      Header="SỐ ƯU TIÊN"
                      FontSize="17"
                      FontWeight="Bold"
                      Margin="3"
                      Padding="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Text="Số bắt đầu"
                               FontSize="14"/>

                    <TextBox Grid.Row="1"
                             x:Name="txtPriorityStart"
                             Text="1"
                             FontSize="19"
                             Height="34"
                             Margin="0,2,0,5"/>


                    <TextBlock Grid.Row="2"
                               Text="Bước tăng"
                               FontSize="14"/>

                    <TextBox Grid.Row="3"
                             x:Name="txtPriorityStep"
                             Text="5"
                             FontSize="19"
                             Height="34"
                             Margin="0,2,0,5"/>


                    <TextBlock Grid.Row="4"
                               Text="Dãy đang gọi"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"/>


                    <StackPanel Grid.Row="5">

                        <TextBlock x:Name="txtPriorityRange"
                                   Text="---"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#8B0000"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>


                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnStartPriority"
                                    Content="BẮT ĐẦU"
                                    Width="120"
                                    Height="40"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Margin="2"/>

                            <Button x:Name="btnNextPriority"
                                    Content="GỌI TIẾP"
                                    Width="120"
                                    Height="40"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Margin="2"/>

                        </StackPanel>


                        <Button x:Name="btnPriorityDirect"
                                Content="MỜI ƯU TIÊN ĐẾN QUẦY"
                                Width="248"
                                Height="36"
                                FontSize="14"
                                FontWeight="Bold"
                                Margin="2,5,2,0"
                                Background="#FFF0F0"
                                Foreground="#8B0000"/>

                    </StackPanel>

                </Grid>

            </GroupBox>

        </Grid>


        <!-- ================================================= -->
        <!-- PREVIEW -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="#E7E9ED"
                BorderBrush="#BBBBBB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6"
                Margin="3,5,3,0">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <TextBlock Grid.Row="0"
                           Text="XEM TRƯỚC MÀN HÌNH"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#444444"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>


                <!-- MÀN HÌNH GIẢ LẬP 16:9 -->

                <Border Grid.Row="1"
                        Background="#FFFDF7"
                        BorderBrush="#555555"
                        BorderThickness="2"
                        CornerRadius="3">

                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both">

                        <Grid Width="960"
                              Height="540">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="380"/>
                                <RowDefinition Height="160"/>
                            </Grid.RowDefinitions>


                            <!-- KHU VỰC GỌI SỐ -->

                            <Grid Grid.Row="0"
                                  Background="#FFFDF7">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>


                                <StackPanel Grid.Row="0"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0">

                                    <TextBlock Text="XIN MỜI SỐ THỨ TỰ"
                                               Foreground="#111111"
                                               FontSize="45"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock x:Name="txtPreviewMode"
                                               Text=""
                                               Foreground="#8B0000"
                                               FontSize="55"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <Grid Grid.Row="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock Grid.Column="0"
                                               x:Name="txtPreviewStart"
                                               Text="001"
                                               Foreground="#000000"
                                               FontSize="190"
                                               FontWeight="Bold"/>


                                    <TextBlock Grid.Column="1"
                                               Text=" – "
                                               Foreground="#333333"
                                               FontSize="70"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>


                                    <TextBlock Grid.Column="2"
                                               x:Name="txtPreviewEnd"
                                               Text="010"
                                               Foreground="#000000"
                                               FontSize="190"
                                               FontWeight="Bold"/>

                                </Grid>

                            </Grid>


                            <!-- KHU VỰC ƯU TIÊN -->

                            <Border Grid.Row="1"
                                    Background="#FFF1F1"
                                    BorderBrush="#8B0000"
                                    BorderThickness="0,2,0,0">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>


                                    <TextBlock Grid.Row="0"
                                               x:Name="txtPreviewPriorityTitle"
                                               Text="ĐỐI TƯỢNG ƯU TIÊN"
                                               Foreground="#8B0000"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"/>


                                    <TextBlock Grid.Row="1"
                                               x:Name="txtPreviewPriorityNotice"
                                               Text="MỜI ĐẾN QUẦY TIẾP NHẬN"
                                               Foreground="#111111"
                                               FontSize="40"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"/>

                                </Grid>

                            </Border>

                        </Grid>

                    </Viewbox>

                </Border>

            </Grid>

        </Border>

    </Grid>

</Window>