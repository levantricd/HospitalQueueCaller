<Window x:Class="HospitalQueueCaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HỆ THỐNG GỌI SỐ THỨ TỰ"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Grid.Row="0"
                   Text="HỆ THỐNG GỌI SỐ THỨ TỰ"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="#111111"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- 2 BỘ SỐ -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SỐ THƯỜNG -->
            <GroupBox Grid.Column="0"
                      Header="SỐ THƯỜNG"
                      FontSize="22"
                      FontWeight="Bold"
                      Margin="10"
                      Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Số bắt đầu"
                               FontSize="18"/>

                    <TextBox Grid.Row="1"
                             x:Name="txtNormalStart"
                             Text="1"
                             FontSize="24"
                             Height="45"
                             Margin="0,5,0,15"/>

                    <TextBlock Grid.Row="2"
                               Text="Bước tăng"
                               FontSize="18"/>

                    <TextBox Grid.Row="3"
                             x:Name="txtNormalStep"
                             Text="10"
                             FontSize="24"
                             Height="45"
                             Margin="0,5,0,15"/>

                    <StackPanel Grid.Row="4">

                        <TextBlock Text="DÃY ĐANG GỌI"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtNormalRange"
                                   Text="001 - 010"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   Foreground="#174A7E"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,15"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnStartNormal"
                                    Content="BẮT ĐẦU"
                                    Width="180"
                                    Height="55"
                                    FontSize="20"
                                    Margin="5"/>

                            <Button x:Name="btnNextNormal"
                                    Content="GỌI TIẾP"
                                    Width="180"
                                    Height="55"
                                    FontSize="20"
                                    Margin="5"/>

                        </StackPanel>

                        <Button x:Name="btnResetNormal"
                                Content="RESET SỐ THƯỜNG"
                                Width="250"
                                Height="45"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="5"/>

                    </StackPanel>

                </Grid>
            </GroupBox>


            <!-- SỐ ƯU TIÊN -->
            <GroupBox Grid.Column="1"
                      Header="SỐ ƯU TIÊN"
                      FontSize="22"
                      FontWeight="Bold"
                      Margin="10"
                      Padding="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Số bắt đầu"
                               FontSize="18"/>

                    <TextBox Grid.Row="1"
                             x:Name="txtPriorityStart"
                             Text="1"
                             FontSize="24"
                             Height="45"
                             Margin="0,5,0,15"/>

                    <TextBlock Grid.Row="2"
                               Text="Bước tăng"
                               FontSize="18"/>

                    <TextBox Grid.Row="3"
                             x:Name="txtPriorityStep"
                             Text="5"
                             FontSize="24"
                             Height="45"
                             Margin="0,5,0,15"/>

                    <StackPanel Grid.Row="4">

                        <TextBlock Text="DÃY ĐANG GỌI"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="txtPriorityRange"
                                   Text="001 - 005"
                                   FontSize="46"
                                   FontWeight="Bold"
                                   Foreground="#8B0000"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,15"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnStartPriority"
                                    Content="BẮT ĐẦU"
                                    Width="180"
                                    Height="55"
                                    FontSize="20"
                                    Margin="5"/>

                            <Button x:Name="btnNextPriority"
                                    Content="GỌI TIẾP"
                                    Width="180"
                                    Height="55"
                                    FontSize="20"
                                    Margin="5"/>

                        </StackPanel>

                        <Button x:Name="btnResetPriority"
                                Content="RESET SỐ ƯU TIÊN"
                                Width="250"
                                Height="45"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                Margin="5"/>

                    </StackPanel>

                </Grid>
            </GroupBox>

        </Grid>


        <!-- TRẠNG THÁI -->
        <Border Grid.Row="2"
                BorderBrush="#999999"
                BorderThickness="1"
                Padding="15"
                Margin="10">

            <StackPanel>

                <TextBlock Text="TRẠNG THÁI HỆ THỐNG"
                           FontSize="18"
                           FontWeight="Bold"/>

                <TextBlock x:Name="txtActiveMode"
                           Text="Chưa gọi số"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#174A7E"
                           Margin="0,5,0,0"/>

                <TextBlock x:Name="txtStatus"
                           Text="Trạng thái: Sẵn sàng"
                           FontSize="18"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>